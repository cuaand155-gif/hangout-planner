{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/book/:handle",
      "destination": "/book"
    },
    {
      "source": "/g/:slug",
      "destination": "/api/page?kind=g&slug=:slug"
    },
    {
      "source": "/p/:slug",
      "destination": "/api/page?kind=p&slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "index.html"
    },
    "api/og.js": {
      "includeFiles": "api/_fonts/**"
    }
  }
}
