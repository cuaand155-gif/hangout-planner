# Server-side only. Never expose the service-role key in browser code.
# Set these in your host's environment; only the api/ handlers read them.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Optional: Google Calendar that keeps syncing, and booking links that check
# it while Waddle is closed (DEPLOY.md step 4).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: booking emails through Resend (DEPLOY.md step 5).
# RESEND_API_KEY=
# BOOKING_EMAIL_FROM=Waddle <bookings@yourdomain.com>
# Only needed off Vercel, or to override the production domain in email links:
# SITE_URL=https://waddle.yourdomain.com
